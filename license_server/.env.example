# Server-only. Use production only after filling every required value below.
LICENSE_SERVER_ENV=development
DATABASE_URL=sqlite:///ABSOLUTE_PATH_TO_LICENSE_SERVER_DB.sqlite3
LICENSE_PRIVATE_KEY_FILE=ABSOLUTE_PATH_TO_ED25519_PRIVATE_KEY_B64_FILE

# Runtime proof is production-only and default disabled. Set the full deployed
# commit only after the final reviewed commit is merged and installed.
LICENSE_RUNTIME_ATTESTATION_ENABLED=false
LICENSE_RUNTIME_SOURCE_COMMIT=

# Internal read-only admin. Keep disabled for public deployments unless accessed
# through an internal address or SSH tunnel.
ADMIN_ENABLED=false
ADMIN_OPERATOR_NAME=
ADMIN_ACCESS_TOKEN_SHA256=

# Client-side local development placeholders.
LICENSE_SERVER_URL=http://127.0.0.1:8787
LICENSE_PUBLIC_KEY=REPLACE_WITH_ED25519_PUBLIC_KEY_B64