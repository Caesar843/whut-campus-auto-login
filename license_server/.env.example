# Server-only. Use production only after filling every required value below.
LICENSE_SERVER_ENV=development
DATABASE_URL=sqlite:///ABSOLUTE_PATH_TO_LICENSE_SERVER_DB.sqlite3
LICENSE_PRIVATE_KEY_FILE=ABSOLUTE_PATH_TO_ED25519_PRIVATE_KEY_B64_FILE

# Runtime proof is production-only and default disabled. Set the full deployed
# commit only after the final reviewed commit is merged and installed.
LICENSE_RUNTIME_ATTESTATION_ENABLED=false
LICENSE_RUNTIME_SOURCE_COMMIT=

# Payment is disabled unless explicitly set to mock or wechat_native.
PAYMENT_PROVIDER=disabled
# Required only when PAYMENT_PROVIDER=mock. Use a random local/preproduction token.
PAYMENT_MOCK_ADMIN_TOKEN=REPLACE_WITH_RANDOM_MOCK_TOKEN_AT_LEAST_16_CHARS
# Required only when PAYMENT_PROVIDER=wechat_native. Keep keys server-side.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=ABSOLUTE_PATH_TO_MERCHANT_RSA_PRIVATE_KEY_PEM
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=ABSOLUTE_PATH_TO_WECHAT_PAY_RSA_PUBLIC_KEY_PEM
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://REPLACE_WITH_LICENSE_DOMAIN/api/v1/payment/wechat/notify
PAYMENT_PRICE_FEN=990
PAYMENT_CURRENCY=CNY
PAYMENT_CHANNELS=wechat_pay
PAYMENT_ORDER_TTL_MINUTES=15

# Run the reliable notification inbox consumer as a separate process.
PAYMENT_NOTIFICATION_WORKER_ENABLED=false
PAYMENT_NOTIFICATION_WORKER_POLL_SECONDS=1
PAYMENT_NOTIFICATION_MAX_ATTEMPTS=8

# Run payment reconciliation compensation as a separate process. It stays off
# until production Schema V5 and real WeChat merchant connectivity are verified.
PAYMENT_RECONCILIATION_WORKER_ENABLED=false
PAYMENT_RECONCILIATION_WORKER_SCAN_INTERVAL_SECONDS=30
PAYMENT_RECONCILIATION_WORKER_RECENT_ORDER_WINDOW_SECONDS=600
PAYMENT_RECONCILIATION_WORKER_MAX_CLAIMS_PER_CYCLE=10
PAYMENT_RECONCILIATION_WORKER_LEASE_SECONDS=60
PAYMENT_RECONCILIATION_WORKER_IDLE_WAIT_SECONDS=1
PAYMENT_RECONCILIATION_WORKER_MAX_ORDERS_PER_SCAN=100
PAYMENT_RECONCILIATION_QUERY_RETRY_BASE_SECONDS=5
PAYMENT_RECONCILIATION_QUERY_RETRY_MAX_SECONDS=300
PAYMENT_RECONCILIATION_MAX_QUERY_ATTEMPTS=8
PAYMENT_RECONCILIATION_CLOSE_RETRY_BASE_SECONDS=5
PAYMENT_RECONCILIATION_CLOSE_RETRY_MAX_SECONDS=300
PAYMENT_RECONCILIATION_MAX_CLOSE_ATTEMPTS=8

# Internal read-only admin. Keep disabled for public deployments unless accessed
# through an internal address or SSH tunnel.
ADMIN_ENABLED=false
ADMIN_OPERATOR_NAME=
ADMIN_ACCESS_TOKEN_SHA256=

# Client-side local development placeholders.
LICENSE_SERVER_URL=http://127.0.0.1:8787
LICENSE_PUBLIC_KEY=REPLACE_WITH_ED25519_PUBLIC_KEY_B64
