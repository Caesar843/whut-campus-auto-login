# Template only. Replace every REPLACE_WITH_* value before production use.
# Production requires HTTPS with a valid certificate.
# /internal/admin and /internal/runtime-attestation must stay blocked from
# the public internet; access the admin console through an SSH tunnel only.
# Do not put administrator tokens or token hashes in Nginx config.

server {
    listen 80;
    server_name REPLACE_WITH_LICENSE_DOMAIN;

    location ^~ /internal/admin {
        return 404;
    }

    location ^~ /internal/runtime-attestation {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

