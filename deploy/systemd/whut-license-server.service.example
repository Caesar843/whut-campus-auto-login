[Unit]
Description=WHUT Campus Auto Login License Server
After=network.target

[Service]
Type=simple
User=whutlogin
Group=whutlogin
WorkingDirectory=/opt/whut-campus-auto-login
EnvironmentFile=/etc/whut-campus-auto-login/license-server.env
Environment=WEB_CONCURRENCY=1
RuntimeDirectory=whut-license-server
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
UMask=0077
ExecStartPre=+/opt/whut-campus-auto-login/.venv/bin/python /opt/whut-campus-auto-login/scripts/ops/verify_running_license_server_attestation.py --startup-gate
ExecStart=/opt/whut-campus-auto-login/.venv/bin/uvicorn license_server.app:app --host 127.0.0.1 --port 8787 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
