#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
    echo "error=arguments_not_allowed" >&2
    echo "result=FAIL"
    exit 2
fi

if gate_output="$(
    /usr/bin/env -i \
        PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        PYTHONNOUSERSITE=1 \
        /usr/bin/python3 -I \
        /usr/local/libexec/whut-license-startup-gate
)"; then
    :
else
    gate_status=$?
    if [ -n "$gate_output" ]; then
        printf '%s\n' "$gate_output"
    fi
    exit "$gate_status"
fi

exec /usr/bin/env -i \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONNOUSERSITE=1 \
    /opt/whut-campus-auto-login/.venv/bin/python -I \
    /opt/whut-campus-auto-login/scripts/ops/verify_running_license_server_attestation.py \
    --live-audit
